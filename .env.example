# ─── Database ──────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/farmops"

# ─── Authentication ────────────────────────────────────
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── App Configuration ─────────────────────────────────
# Public URL for email links and webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Email (SMTP) ──────────────────────────────────────
# For dev, use MailHog (docker-compose) or Mailtrap
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FarmOps <noreply@farmops.com>"

# ─── Production SMTP Example ───────────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
